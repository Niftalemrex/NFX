---
// Astro component frontmatter

import Layout from '../../layouts/BaseLayout.astro';
import './SmartMoneyConcepts.css';
---

<Layout title="Smart Money Concepts - NFX Learning">
 
  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Smart Money Concepts</h1>
        <p class="subtitle">Follow the institutional flow - Understanding how banks and institutions trade</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>What are Smart Money Concepts?</h2>
        <p>
          Smart Money Concepts (SMC) is a trading methodology that focuses on understanding how institutional traders 
          (banks, hedge funds, market makers) operate in the forex market. It reveals their footprints and allows 
          retail traders to follow their flow.
        </p>
        
        <div class="key-idea">
          <p>"Smart money creates liquidity, hunts stops, and leaves footprints. Learn to read them."</p>
        </div>
      </section>

      <!-- Core Concepts -->
      <section class="section">
        <h2>Core SMC Concepts</h2>
        <div class="concepts-grid">
          <div class="concept-card">
            <h3>🏦 Institutional Order Flow</h3>
            <p>Understanding how large players enter and exit positions without moving the market against themselves</p>
          </div>
          <div class="concept-card">
            <h3>🎯 Liquidity Hunting</h3>
            <p>Institutions target stop-loss clusters to accumulate positions</p>
          </div>
          <div class="concept-card">
            <h3>📊 Mitigation Blocks</h3>
            <p>Areas where price has previously caused reactions - order blocks</p>
          </div>
          <div class="concept-card">
            <h3>⚖️ Inducement</h3>
            <p>False moves designed to trap retail traders before the real move</p>
          </div>
        </div>
      </section>

      <!-- Order Blocks -->
      <section class="section">
        <h2>Order Blocks (OB)</h2>
        <p>
          Order blocks are the last opposing candle before a strong impulsive move. They represent where institutions 
          placed their large orders.
        </p>
        
        <div class="ob-types">
          <div class="ob-card">
            <h3>Bullish Order Block</h3>
            <p>Last down candle before a strong up move</p>
            <div class="ob-example">Look to BUY at this zone</div>
          </div>
          <div class="ob-card">
            <h3>Bearish Order Block</h3>
            <p>Last up candle before a strong down move</p>
            <div class="ob-example">Look to SELL at this zone</div>
          </div>
        </div>
        
        <div class="tip">💡 Unmitigated order blocks are stronger than those already tested</div>
      </section>

      <!-- Liquidity Concepts -->
      <section class="section">
        <h2>Liquidity Concepts</h2>
        <div class="liquidity-grid">
          <div class="liquid-card">
            <h3>Buy Side Liquidity (BSL)</h3>
            <p>Stop losses located above previous highs. Targets for sell programs.</p>
          </div>
          <div class="liquid-card">
            <h3>Sell Side Liquidity (SSL)</h3>
            <p>Stop losses located below previous lows. Targets for buy programs.</p>
          </div>
          <div class="liquid-card">
            <h3>Trendline Liquidity</h3>
            <p>Stop orders placed beyond trendlines</p>
          </div>
          <div class="liquid-card">
            <h3>Double Top/Bottom Liquidity</h3>
            <p>Stops placed beyond equal highs/lows</p>
          </div>
        </div>
      </section>

      <!-- Market Structure -->
      <section class="section">
        <h2>Advanced Market Structure</h2>
        <div class="structure-box">
          <div class="struct-item">
            <h3>Break of Structure (BOS)</h3>
            <p>Price breaks a previous swing high/low, confirming trend continuation</p>
          </div>
          <div class="struct-item">
            <h3>Change of Character (CHoCH)</h3>
            <p>Price breaks market structure, signaling potential reversal</p>
          </div>
          <div class="struct-item">
            <h3>Mitigation</h3>
            <p>Price returns to an order block or fair value gap</p>
          </div>
        </div>
      </section>

      <!-- Fair Value Gaps -->
      <section class="section">
        <h2>Fair Value Gaps (FVG)</h2>
        <p>
          Imbalance areas where price moved too quickly, leaving an inefficiency. Price often returns to fill these gaps.
        </p>
        <div class="fvg-info">
          <h3>How to identify:</h3>
          <ul>
            <li>3 candle sequence where middle candle's wicks don't overlap with first and third</li>
            <li>The gap between wicks is the Fair Value Gap</li>
            <li>Higher timeframe FVGs are more significant</li>
          </ul>
        </div>
      </section>

      <!-- Mitigation Blocks -->
      <section class="section">
        <h2>Mitigation Blocks</h2>
        <p>
          A mitigation block is an order block that has been tested and respected by price. These become key reversal zones.
        </p>
        <div class="mitigation-box">
          <div class="mit-type">
            <h3>✅ Mitigated Order Block</h3>
            <p>Price has already visited - less effective</p>
          </div>
          <div class="mit-type">
            <h3>🔄 Unmitigated Order Block</h3>
            <p>Price hasn't visited yet - stronger potential</p>
          </div>
        </div>
      </section>

      <!-- Inducement -->
      <section class="section">
        <h2>Inducement (False Breakouts)</h2>
        <p>
          Institutions often push price beyond key levels to trigger retail stop losses and entries, 
          creating liquidity before moving in the opposite direction.
        </p>
        <div class="inducement-tip">
          <h3>How to trade inducement:</h3>
          <ul>
            <li>Identify key support/resistance levels</li>
            <li>Wait for price to break the level</li>
            <li>Look for reversal confirmation</li>
            <li>Enter in the direction of the higher timeframe trend</li>
          </ul>
        </div>
      </section>

      <!-- SMC Trading Model -->
      <section class="section">
        <h2>Complete SMC Trading Model</h2>
        <div class="trading-model">
          <div class="model-step">
            <span class="step-num">1</span>
            <div>
              <strong>Identify Higher Timeframe Trend</strong>
              <p>Daily/Weekly chart direction</p>
            </div>
          </div>
          <div class="model-step">
            <span class="step-num">2</span>
            <div>
              <strong>Find Key Levels</strong>
              <p>Previous highs/lows, order blocks, FVGs</p>
            </div>
          </div>
          <div class="model-step">
            <span class="step-num">3</span>
            <div>
              <strong>Wait for Liquidity Sweep</strong>
              <p>Price hunts stops beyond levels</p>
            </div>
          </div>
          <div class="model-step">
            <span class="step-num">4</span>
            <div>
              <strong>Look for Displacement</strong>
              <p>Strong move away from liquidity grab</p>
            </div>
          </div>
          <div class="model-step">
            <span class="step-num">5</span>
            <div>
              <strong>Enter at Order Block/FVG</strong>
              <p>On retracement to mitigation zone</p>
            </div>
          </div>
          <div class="model-step">
            <span class="step-num">6</span>
            <div>
              <strong>Target Next Liquidity Level</strong>
              <p>Opposite side liquidity</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Session Times -->
      <section class="section">
        <h2>Best Trading Sessions for SMC</h2>
        <div class="sessions-grid">
          <div class="session-card">
            <h3>🕐 London Session</h3>
            <p>3:00 AM - 12:00 PM EST</p>
            <span>Highest liquidity and volatility</span>
          </div>
          <div class="session-card">
            <h3>🕐 New York Session</h3>
            <p>8:00 AM - 5:00 PM EST</p>
            <span>Best for USD pairs</span>
          </div>
          <div class="session-card">
            <h3>🕐 London-New York Overlap</h3>
            <p>8:00 AM - 12:00 PM EST</p>
            <span>Best trading window of the day</span>
          </div>
        </div>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Continue Learning Technical Analysis</h2>
        <div class="next-links">
          <a href="/TechnicalAnalysis/SupplyDemand" class="next-link">
            <span>Supply & Demand →</span>
            <small>Key reversal zones</small>
          </a>
          <a href="/TechnicalAnalysis/Indicators" class="next-link">
            <span>Technical Indicators →</span>
            <small>RSI, MACD, Bollinger Bands</small>
          </a>
        </div>
      </section>
    </div>
  </main>
  
  
</Layout>