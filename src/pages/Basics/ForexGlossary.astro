---
// Astro component frontmatter

import Layout from '../../layouts/BaseLayout.astro';
import './ForexGlossary.css';
---

<Layout title="Forex Glossary - NFX Learning">

  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Forex Glossary</h1>
        <p class="subtitle">A-Z of essential trading terms every trader needs to know</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>Complete Forex Trading Dictionary</h2>
        <p>
          Mastering forex terminology is essential for understanding market analysis, communicating with other traders, 
          and executing trades confidently. Use this glossary as your reference guide.
        </p>
      </section>

      <!-- A-D -->
      <section class="section">
        <h2>A - D</h2>
        <div class="glossary-grid">
          <div class="term-item">
            <h3>Ask Price</h3>
            <p>The price at which you can BUY a currency pair. Also called the offer price.</p>
          </div>
          <div class="term-item">
            <h3>Bid Price</h3>
            <p>The price at which you can SELL a currency pair.</p>
          </div>
          <div class="term-item">
            <h3>Broker</h3>
            <p>An intermediary that executes your trades in the forex market.</p>
          </div>
          <div class="term-item">
            <h3>Bull Market</h3>
            <p>A market where prices are rising or expected to rise.</p>
          </div>
          <div class="term-item">
            <h3>Bear Market</h3>
            <p>A market where prices are falling or expected to fall.</p>
          </div>
          <div class="term-item">
            <h3>Base Currency</h3>
            <p>The first currency in a pair (e.g., EUR in EUR/USD).</p>
          </div>
          <div class="term-item">
            <h3>Quote Currency</h3>
            <p>The second currency in a pair (e.g., USD in EUR/USD).</p>
          </div>
          <div class="term-item">
            <h3>Cross Pair</h3>
            <p>A currency pair that doesn't include the US Dollar (e.g., EUR/GBP).</p>
          </div>
          <div class="term-item">
            <h3>Carry Trade</h3>
            <p>Borrowing a low-interest currency to buy a high-interest currency.</p>
          </div>
          <div class="term-item">
            <h3>Commission</h3>
            <p>A fee charged by some brokers per trade instead of wider spreads.</p>
          </div>
        </div>
      </section>

      <!-- E-H -->
      <section class="section">
        <h2>E - H</h2>
        <div class="glossary-grid">
          <div class="term-item">
            <h3>ECN Broker</h3>
            <p>Electronic Communication Network - Direct access to interbank market.</p>
          </div>
          <div class="term-item">
            <h3>EMA</h3>
            <p>Exponential Moving Average - Gives more weight to recent prices.</p>
          </div>
          <div class="term-item">
            <h3>Entry Order</h3>
            <p>An order to buy or sell at a specified price in the future.</p>
          </div>
          <div class="term-item">
            <h3>Equity</h3>
            <p>Account balance + unrealized profit/loss from open positions.</p>
          </div>
          <div class="term-item">
            <h3>FIFO</h3>
            <p>First In, First Out - Order filling method required for US traders.</p>
          </div>
          <div class="term-item">
            <h3>Fundamental Analysis</h3>
            <p>Analyzing economic data and news to predict price movements.</p>
          </div>
          <div class="term-item">
            <h3>Gap</h3>
            <p>Price difference between closing and opening price when market reopens.</p>
          </div>
          <div class="term-item">
            <h3>Hedging</h3>
            <p>Opening opposite positions to reduce risk.</p>
          </div>
        </div>
      </section>

      <!-- I-L -->
      <section class="section">
        <h2>I - L</h2>
        <div class="glossary-grid">
          <div class="term-item">
            <h3>Indicators</h3>
            <p>Mathematical calculations based on price/volume to predict movements.</p>
          </div>
          <div class="term-item">
            <h3>Interbank Market</h3>
            <p>The network of banks trading currencies directly with each other.</p>
          </div>
          <div class="term-item">
            <h3>Leverage</h3>
            <p>Using borrowed capital to increase potential returns (e.g., 1:100).</p>
          </div>
          <div class="term-item">
            <h3>Liquidity</h3>
            <p>How easily an asset can be bought/sold without affecting its price.</p>
          </div>
          <div class="term-item">
            <h3>Limit Order</h3>
            <p>An order to buy below current price or sell above current price.</p>
          </div>
          <div class="term-item">
            <h3>Long Position</h3>
            <p>Buying a currency expecting its value to rise.</p>
          </div>
        </div>
      </section>

      <!-- M-P -->
      <section class="section">
        <h2>M - P</h2>
        <div class="glossary-grid">
          <div class="term-item">
            <h3>Margin</h3>
            <p>The amount required to open and maintain a leveraged position.</p>
          </div>
          <div class="term-item">
            <h3>Margin Call</h3>
            <p>When equity falls below required margin, broker may close positions.</p>
          </div>
          <div class="term-item">
            <h3>Market Order</h3>
            <p>An order to buy or sell immediately at current market price.</p>
          </div>
          <div class="term-item">
            <h3>Pip</h3>
            <p>Percentage in Point - Smallest price move in a currency pair.</p>
          </div>
          <div class="term-item">
            <h3>Pipette</h3>
            <p>Fraction of a pip (0.1 of a pip).</p>
          </div>
          <div class="term-item">
            <h3>Position</h3>
            <p>An open trade (either long or short).</p>
          </div>
        </div>
      </section>

      <!-- Q-T -->
      <section class="section">
        <h2>Q - T</h2>
        <div class="glossary-grid">
          <div class="term-item">
            <h3>Quote Currency</h3>
            <p>The second currency in a pair (USD in EUR/USD).</p>
          </div>
          <div class="term-item">
            <h3>Resistance</h3>
            <p>A price level where selling pressure may overcome buying pressure.</p>
          </div>
          <div class="term-item">
            <h3>Risk Management</h3>
            <p>Strategies to limit potential losses (stop losses, position sizing).</p>
          </div>
          <div class="term-item">
            <h3>Rollover</h3>
            <p>Extending the settlement date of an open position to the next day.</p>
          </div>
          <div class="term-item">
            <h3>Slippage</h3>
            <p>When an order fills at a different price than requested.</p>
          </div>
          <div class="term-item">
            <h3>Spread</h3>
            <p>The difference between bid and ask price.</p>
          </div>
          <div class="term-item">
            <h3>Stop Loss</h3>
            <p>An order to close a trade at a specific price to limit losses.</p>
          </div>
          <div class="term-item">
            <h3>Support</h3>
            <p>A price level where buying pressure may overcome selling pressure.</p>
          </div>
          <div class="term-item">
            <h3>Swap</h3>
            <p>Interest paid or earned for holding positions overnight.</p>
          </div>
        </div>
      </section>

      <!-- U-Z -->
      <section class="section">
        <h2>U - Z</h2>
        <div class="glossary-grid">
          <div class="term-item">
            <h3>Volatility</h3>
            <p>The degree of price fluctuation in a currency pair.</p>
          </div>
          <div class="term-item">
            <h3>Volume</h3>
            <p>The number of trades or contracts traded in a period.</p>
          </div>
          <div class="term-item">
            <h3>Whipsaw</h3>
            <p>A rapid price reversal that triggers stop losses.</p>
          </div>
          <div class="term-item">
            <h3>XAU</h3>
            <p>The symbol for Gold in forex trading.</p>
          </div>
          <div class="term-item">
            <h3>XAG</h3>
            <p>The symbol for Silver in forex trading.</p>
          </div>
          <div class="term-item">
            <h3>Yield</h3>
            <p>The return on investment, often referring to bond interest rates.</p>
          </div>
          <div class="term-item">
            <h3>Zero-sum Game</h3>
            <p>For every winner, there is a loser in forex trading.</p>
          </div>
        </div>
      </section>

      <!-- Quick Reference -->
      <section class="section">
        <h2>Quick Reference: Major Currency Symbols</h2>
        <div class="currency-grid">
          <div class="currency-item">🇺🇸 USD - US Dollar</div>
          <div class="currency-item">🇪🇺 EUR - Euro</div>
          <div class="currency-item">🇬🇧 GBP - British Pound</div>
          <div class="currency-item">🇯🇵 JPY - Japanese Yen</div>
          <div class="currency-item">🇦🇺 AUD - Australian Dollar</div>
          <div class="currency-item">🇨🇦 CAD - Canadian Dollar</div>
          <div class="currency-item">🇨🇭 CHF - Swiss Franc</div>
          <div class="currency-item">🇳🇿 NZD - New Zealand Dollar</div>
          <div class="currency-item">🇨🇳 CNY - Chinese Yuan</div>
          <div class="currency-item">🇸🇬 SGD - Singapore Dollar</div>
          <div class="currency-item">🇿🇦 ZAR - South African Rand</div>
          <div class="currency-item">🇲🇽 MXN - Mexican Peso</div>
        </div>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Continue Learning Basics</h2>
        <div class="next-links">
          <a href="/Basics/TradingPsychology" class="next-link">
            <span>Trading Psychology →</span>
            <small>Master your emotions</small>
          </a>
          <a href="/Basics/RiskManagement" class="next-link">
            <span>Risk Management →</span>
            <small>Protect your capital</small>
          </a>
        </div>
      </section>
    </div>
  </main>
  

</Layout>