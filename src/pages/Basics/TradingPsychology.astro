---
// Astro component frontmatter

import Layout from '../../layouts/BaseLayout.astro';
import './TradingPsychology.css';
---

<Layout title="Trading Psychology - NFX Learning">
 
  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Trading Psychology</h1>
        <p class="subtitle">Master your emotions - The key to consistent trading success</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>Why Psychology Matters</h2>
        <p>
          Trading is 80% psychology and 20% strategy. Even the best trading system will fail if you can't control 
          your emotions. Understanding and mastering trading psychology is the difference between consistent profits 
          and consistent losses.
        </p>
        
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">80%</div>
            <div class="stat-label">Psychology</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">20%</div>
            <div class="stat-label">Strategy</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">90%</div>
            <div class="stat-label">Traders Fail</div>
          </div>
        </div>
      </section>

      <!-- Common Emotions -->
      <section class="section">
        <h2>The 5 Deadly Emotions</h2>
        
        <div class="emotion-card">
          <h3>😨 Fear</h3>
          <p>Fear of losing money causes hesitation, missed opportunities, and premature exits.</p>
          <div class="solution">Solution: Accept losses as cost of business. Use proper position sizing.</div>
        </div>
        
        <div class="emotion-card">
          <h3>🤑 Greed</h3>
          <p>Wanting more than reasonable causes holding too long, adding to losers, and overtrading.</p>
          <div class="solution">Solution: Set realistic targets. Take profits at predefined levels.</div>
        </div>
        
        <div class="emotion-card">
          <h3>😤 Revenge</h3>
          <p>Trying to recover losses immediately leads to impulsive, oversized trades.</p>
          <div class="solution">Solution: Step away after losses. Stick to your plan.</div>
        </div>
        
        <div class="emotion-card">
          <h3>😌 Hope</h3>
          <p>Hoping a losing trade will turn around instead of cutting losses.</p>
          <div class="solution">Solution: Always use stop losses. Never hope, trade.</div>
        </div>
        
        <div class="emotion-card">
          <h3>😎 Overconfidence</h3>
          <p>Winning streaks lead to larger positions and abandoning your strategy.</p>
          <div class="solution">Solution: Stay humble. Markets can turn anytime.</div>
        </div>
      </section>

      <!-- Cognitive Biases -->
      <section class="section">
        <h2>Trading Biases to Avoid</h2>
        <div class="biases-grid">
          <div class="bias-card">
            <h3>Confirmation Bias</h3>
            <p>Seeking information that confirms your existing beliefs.</p>
          </div>
          <div class="bias-card">
            <h3>Recency Bias</h3>
            <p>Giving more weight to recent events than historical data.</p>
          </div>
          <div class="bias-card">
            <h3>Overconfidence Bias</h3>
            <p>Overestimating your abilities after wins.</p>
          </div>
          <div class="bias-card">
            <h3>Loss Aversion</h3>
            <p>Feeling losses twice as strongly as gains.</p>
          </div>
          <div class="bias-card">
            <h3>Hindsight Bias</h3>
            <p>"I knew it all along" - Believing past events were predictable.</p>
          </div>
          <div class="bias-card">
            <h3>Anchoring Bias</h3>
            <p>Relying too heavily on one piece of information (e.g., entry price).</p>
          </div>
        </div>
      </section>

      <!-- The Trading Cycle -->
      <section class="section">
        <h2>The Emotional Trading Cycle</h2>
        <div class="cycle">
          <div class="cycle-step">📈 Euphoria → 📉 Anxiety → 😨 Fear → 😤 Desperation → 😌 Panic → 😔 Depression → 📈 Hope → 🤑 Relief → 😎 Optimism → 📈 Euphoria</div>
        </div>
        <p class="cycle-note">The cycle repeats until you learn to control emotions and follow a system.</p>
      </section>

      <!-- Building Discipline -->
      <section class="section">
        <h2>Building Trading Discipline</h2>
        <div class="discipline-list">
          <div class="discipline-item">
            <span class="num">1</span>
            <div>
              <h3>Create a Trading Plan</h3>
              <p>Write down entry/exit rules, risk parameters, and daily goals</p>
            </div>
          </div>
          <div class="discipline-item">
            <span class="num">2</span>
            <div>
              <h3>Keep a Trading Journal</h3>
              <p>Record every trade, including emotional state before/after</p>
            </div>
          </div>
          <div class="discipline-item">
            <span class="num">3</span>
            <div>
              <h3>Set Daily Loss Limits</h3>
              <p>Stop trading after reaching max daily loss (2-3% of account)</p>
            </div>
          </div>
          <div class="discipline-item">
            <span class="num">4</span>
            <div>
              <h3>Take Breaks</h3>
              <p>Step away after losses or during emotional highs</p>
            </div>
          </div>
          <div class="discipline-item">
            <span class="num">5</span>
            <div>
              <h3>Review Performance Weekly</h3>
              <p>Analyze what worked and what didn't - focus on process, not profits</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Developing the Right Mindset -->
      <section class="section">
        <h2>The Winning Mindset</h2>
        <div class="mindset-grid">
          <div class="mindset-card">
            <h3>✅ Accept Losses</h3>
            <p>Losses are part of trading. Focus on following your system.</p>
          </div>
          <div class="mindset-card">
            <h3>✅ Be Patient</h3>
            <p>Wait for high-probability setups. Don't force trades.</p>
          </div>
          <div class="mindset-card">
            <h3>✅ Stay Humble</h3>
            <p>The market is always right. Adapt or get left behind.</p>
          </div>
          <div class="mindset-card">
            <h3>✅ Think in Probabilities</h3>
            <p>No trade is guaranteed. Focus on edge over many trades.</p>
          </div>
          <div class="mindset-card">
            <h3>✅ Detach from Money</h3>
            <p>Trade the plan, not the P&L. Results will follow.</p>
          </div>
          <div class="mindset-card">
            <h3>✅ Continuous Learning</h3>
            <p>Always improve. Review, adapt, and evolve.</p>
          </div>
        </div>
      </section>

      <!-- Practical Exercises -->
      <section class="section">
        <h2>Psychology Exercises</h2>
        <div class="exercises">
          <div class="exercise">
            <h3>📝 Journaling</h3>
            <p>Write down emotions before, during, and after each trade for 30 days.</p>
          </div>
          <div class="exercise">
            <h3>🧘 Meditation</h3>
            <p>5-10 minutes daily to improve focus and emotional control.</p>
          </div>
          <div class="exercise">
            <h3>📊 Demo Trading</h3>
            <p>Practice emotional control without financial risk.</p>
          </div>
          <div class="exercise">
            <h3>🎯 Set Weekly Goals</h3>
            <p>Focus on process goals (follow plan) not profit goals.</p>
          </div>
        </div>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Continue Learning Basics</h2>
        <div class="next-links">
          <a href="/Basics/RiskManagement" class="next-link">
            <span>Risk Management →</span>
            <small>Protect your capital</small>
          </a>
          <a href="/Basics/MoneyManagement" class="next-link">
            <span>Money Management →</span>
            <small>Position sizing & leverage</small>
          </a>
        </div>
      </section>
    </div>
  </main>
  
 
</Layout>