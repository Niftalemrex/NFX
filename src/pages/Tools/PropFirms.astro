---
// Astro component frontmatter

import Layout from '../../layouts/BaseLayout.astro';
import './PropFirms.css';
---

<Layout title="Prop Firms - NFX Learning">

  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Prop Firms</h1>
        <p class="subtitle">Compare top funding programs and get capital to trade</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>What are Prop Firms?</h2>
        <p>
          Proprietary trading firms (Prop Firms) provide traders with capital to trade in exchange for a share of the profits. 
          They evaluate your trading skills through challenges or evaluations before funding you with real money.
        </p>
        
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">$100K+</div>
            <div class="stat-label">Average Funding</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">80-95%</div>
            <div class="stat-label">Profit Split</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">1-2 Phases</div>
            <div class="stat-label">Evaluation Steps</div>
          </div>
        </div>
      </section>

      <!-- How Prop Firms Work -->
      <section class="section">
        <h2>How Prop Firms Work</h2>
        <div class="steps-container">
          <div class="step-item">
            <div class="step-number">1</div>
            <div>
              <h3>Choose a Challenge</h3>
              <p>Select account size ($10K - $200K+) and pay a one-time fee</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">2</div>
            <div>
              <h3>Pass Evaluation</h3>
              <p>Meet profit targets without breaking drawdown rules</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">3</div>
            <div>
              <h3>Get Funded</h3>
              <p>Receive a live funded account with profit split</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">4</div>
            <div>
              <h3>Keep Trading</h3>
              <p>Scale up account as you prove consistency</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Top Prop Firms -->
      <section class="section">
        <h2>Top Prop Firms Comparison</h2>
        <div class="firms-table">
          <div class="table-header">
            <span>Firm</span>
            <span>Max Funding</span>
            <span>Profit Split</span>
            <span>Evaluation</span>
          </div>
          <div class="table-row">
            <span class="firm-name">FTMO</span>
            <span>$200K</span>
            <span>90%</span>
            <span>2 Phases</span>
          </div>
          <div class="table-row">
            <span class="firm-name">MyFundedFX</span>
            <span>$300K</span>
            <span>90%</span>
            <span>1 Phase</span>
          </div>
          <div class="table-row">
            <span class="firm-name">The Funded Trader</span>
            <span>$200K</span>
            <span>90%</span>
            <span>2 Phases</span>
          </div>
          <div class="table-row">
            <span class="firm-name">Funding Pips</span>
            <span>$200K</span>
            <span>90%</span>
            <span>1-2 Phases</span>
          </div>
          <div class="table-row">
            <span class="firm-name">Alpha Capital Group</span>
            <span>$200K</span>
            <span>85%</span>
            <span>2 Phases</span>
          </div>
        </div>
      </section>

      <!-- Common Rules -->
      <section class="section">
        <h2>Common Prop Firm Rules</h2>
        <div class="rules-grid">
          <div class="rule-card">
            <h3>📉 Daily Drawdown</h3>
            <p>Maximum loss allowed per day (typically 5%)</p>
          </div>
          <div class="rule-card">
            <h3>📊 Max Drawdown</h3>
            <p>Maximum total loss from peak (8-12%)</p>
          </div>
          <div class="rule-card">
            <h3>🎯 Profit Target</h3>
            <p>Required profit to pass (8-12%)</p>
          </div>
          <div class="rule-card">
            <h3>⏰ Min Trading Days</h3>
            <p>Minimum days before passing (often 5-10)</p>
          </div>
          <div class="rule-card">
            <h3>📈 Consistency Rule</h3>
            <p>No single day can exceed 30-50% of profit target</p>
          </div>
          <div class="rule-card">
            <h3>🌙 Weekend Holding</h3>
            <p>Rules about holding over weekends</p>
          </div>
        </div>
      </section>

      <!-- Tips for Passing -->
      <section class="section">
        <h2>Tips for Passing Prop Firm Challenges</h2>
        <div class="tips-list">
          <div class="tip-item">
            <span class="tip-icon">🎯</span>
            <div>
              <h3>Start Small</h3>
              <p>Begin with smaller account sizes to minimize risk</p>
            </div>
          </div>
          <div class="tip-item">
            <span class="tip-icon">📊</span>
            <div>
              <h3>Focus on Risk Management</h3>
              <p>Risk 0.5-1% per trade to stay within drawdown limits</p>
            </div>
          </div>
          <div class="tip-item">
            <span class="tip-icon">📈</span>
            <div>
              <h3>Trade Your Strategy</h3>
              <p>Don't change your approach just for the challenge</p>
            </div>
          </div>
          <div class="tip-item">
            <span class="tip-icon">⏰</span>
            <div>
              <h3>Take Your Time</h3>
              <p>There's no rush - consistency over speed</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Red Flags -->
      <section class="section">
        <h2>Warning Signs to Avoid</h2>
        <ul class="warning-list">
          <li>❌ Unrealistic profit targets (20%+ in a month)</li>
          <li>❌ No transparent rules about drawdown</li>
          <li>❌ Bad reviews or scam reports online</li>
          <li>❌ Hidden fees or unclear refund policy</li>
          <li>❌ No customer support or long response times</li>
        </ul>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Explore More Tools & Resources</h2>
        <div class="next-links">
          <a href="/ToolsResources/ForexNews" class="next-link">
            <span>Forex News →</span>
            <small>Live economic calendar & analysis</small>
          </a>
          <a href="/ToolsResources/Brokers" class="next-link">
            <span>Brokers →</span>
            <small>Find the best broker for you</small>
          </a>
        </div>
      </section>
    </div>
  </main>
  

</Layout>