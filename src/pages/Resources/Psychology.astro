// Function to extract book info from filename
function extractBookInfo(filename: string): BookInfo {
  let name: string = filename.replace(/\.(pdf|epub)$/i, '');
  let title: string = name;
  let author: string = "Unknown Author";
  
  const patterns: RegExp[] = [
    /^([^-]+)\s*-\s*(.+)$/,
    /^(.+?)\s+by\s+(.+)$/i,
    /^(.+?)_by_(.+)$/i,
  ];
  
  for (const pattern of patterns) {
    const match: RegExpMatchArray | null = name.match(pattern);
    if (match) {
      if (pattern.toString().includes('by')) {
        title = match[1] || title;
        author = match[2] || author;
      } else {
        author = match[1] || author;
        title = match[2] || title;
      }
      break;
    }
  }
  
  title = title.replace(/[_-]/g, ' ').replace(/\s+/g, ' ').trim();
  author = author.replace(/[_-]/g, ' ').replace(/\s+/g, ' ').trim();
  title = title.split(' ').map((word: string) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ');
  
  let category: string = "Psychology";
  const titleLower: string = title.toLowerCase();
  if (titleLower.includes('trading')) category = "Trading Psychology";
  else if (titleLower.includes('discipline')) category = "Discipline";
  else if (titleLower.includes('mindset')) category = "Mindset";
  else if (titleLower.includes('success')) category = "Success";
  
  let rating: number = 4;
  const classics: string[] = [
    'Trading in the Zone', 'The Disciplined Trader', 'Think and Grow Rich',
    'The Power of Now', 'The Chimp Paradox', 'Reminiscences'
  ];
  if (classics.some((c: string) => title.includes(c))) rating = 5;
  
  return { title, author, category, rating };
}

const books: Book[] = bookFiles.map((file: string, index: number) => {
  const info: BookInfo = extractBookInfo(file);
  const isPdf: boolean = file.toLowerCase().endsWith('.pdf');
  return {
    id: index + 1,
    title: info.title,
    author: info.author,
    category: info.category,
    rating: info.rating,
    year: "Unknown",
    description: `${info.title} by ${info.author} - Essential reading for traders.`,
    file: file,
    type: isPdf ? 'pdf' : 'epub'
  };
});

const categories: string[] = [...new Set(books.map((book: Book) => book.category))];
const featuredBooks: Book[] = books.filter((b: Book) => b.rating === 5).slice(0, 8);
const totalBooks: number = books.length;

function renderStars(rating: number): string {
  const fullStar = '&#9733;';
  const emptyStar = '&#9734;';
  return fullStar.repeat(rating) + emptyStar.repeat(5 - rating);
}
---

<Layout title="Trading Psychology Library - NFX Learning">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <main class="psychology-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Trading Psychology Library</h1>
        <p class="subtitle">Master your mindset - {totalBooks}+ premium psychology books for traders</p>
        <div class="hero-stats">
          <div class="hero-stat">
            <div class="stat-number">{totalBooks}+</div>
            <div class="stat-label">Premium Books</div>
          </div>
          <div class="hero-stat">
            <div class="stat-number">80+</div>
            <div class="stat-label">Expert Authors</div>
          </div>
          <div class="hero-stat">
            <div class="stat-number">100%</div>
            <div class="stat-label">Free Access</div>
          </div>
        </div>
      </div>
      <div class="hero-glow"></div>
    </section>

    <div class="content-wrapper">
      <!-- Why Psychology Section -->
      <section class="section">
        <h2>Why Psychology is Everything</h2>
        <p>
          Trading is 80% psychology and 20% strategy. Even the best trading system will fail if you can't control 
          your emotions. This library contains {totalBooks}+ premium books to help you develop the right mindset.
        </p>
        
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-value">80%</div>
            <div class="stat-label">Psychology</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">20%</div>
            <div class="stat-label">Strategy</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">90%</div>
            <div class="stat-label">Fail Due to Psychology</div>
          </div>
        </div>
      </section>

      <!-- Featured Books Section -->
      <section class="section">
        <h2>Featured Classics</h2>
        <p>Essential reading for every trader - These books have transformed countless trading careers.</p>
        
        <div class="books-grid">
          {featuredBooks.map((book: Book) => (
            <div class="book-card" data-category={book.category.toLowerCase()} data-title={book.title.toLowerCase()} data-author={book.author.toLowerCase()}>
              <div class="book-icon">&#128218;</div>
              <h3>{book.title}</h3>
              <p class="book-author">{book.author}</p>
              <div class="book-rating" set:html={renderStars(book.rating)}></div>
              <p class="book-year">{book.year}</p>
              <p class="book-desc">{book.description}</p>
              <a href={`/books/${encodeURIComponent(book.file)}`} target="_blank" class="read-btn">
                Read Online &rarr;
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- Complete Library Section -->
      <section class="section">
        <h2>Complete Library</h2>
        <p>Browse our complete collection of {totalBooks}+ trading psychology resources.</p>
        
        <div class="search-bar">
          <div class="search-icon">&#128269;</div>
          <input type="text" id="searchInput" placeholder="Search by title or author..." class="search-input" />
          <select id="categoryFilter" class="category-select">
            <option value="all">All Categories</option>
            {categories.map((cat: string) => (
              <option value={cat.toLowerCase()}>{cat}</option>
            ))}
          </select>
        </div>
        
        <div class="books-grid" id="booksGrid">
          {books.map((book: Book) => (
            <div class="book-card" data-category={book.category.toLowerCase()} data-title={book.title.toLowerCase()} data-author={book.author.toLowerCase()}>
              <div class="book-icon">&#128214;</div>
              <h3>{book.title.length > 40 ? book.title.substring(0, 40) + '...' : book.title}</h3>
              <p class="book-author">{book.author}</p>
              <div class="book-rating" set:html={renderStars(book.rating)}></div>
              <div class="book-type">{book.type.toUpperCase()}</div>
              <a href={`/books/${encodeURIComponent(book.file)}`} target="_blank" class="read-btn small">
                Read Online
              </a>
            </div>
          ))}
        </div>
        
        <div class="total-count">
          Showing <span id="visibleCount">{totalBooks}</span> of {totalBooks} books
        </div>
      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  (function() {
    var searchInput = document.getElementById('searchInput');
    var categoryFilter = document.getElementById('categoryFilter');
    var visibleCountSpan = document.getElementById('visibleCount');
    
    if (searchInput && categoryFilter) {
      var bookCards = document.querySelectorAll('.book-card');
      
      function filterBooks() {
        var searchTerm = searchInput.value.toLowerCase();
        var category = categoryFilter.value;
        var visibleCount = 0;
        
        for (var i = 0; i < bookCards.length; i++) {
          var card = bookCards[i];
          var title = card.getAttribute('data-title') || '';
          var author = card.getAttribute('data-author') || '';
          var cardCategory = card.getAttribute('data-category') || '';
          
          var matchesSearch = title.indexOf(searchTerm) !== -1 || author.indexOf(searchTerm) !== -1;
          var matchesCategory = category === 'all' || cardCategory === category;
          
          if (matchesSearch && matchesCategory) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        }
        
        if (visibleCountSpan) {
          visibleCountSpan.textContent = visibleCount;
        }
      }
      
      searchInput.addEventListener('input', filterBooks);
      categoryFilter.addEventListener('change', filterBooks);
    }
  })();
</script>