---
// Astro component frontmatter

import Layout from '../../layouts/BaseLayout.astro';
import './LeakedVideos.css';
---

<Layout title="Leaked Trading Videos - NFX Learning">
  
  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Leaked Videos</h1>
        <p class="subtitle">Exclusive trading content - Institutional secrets revealed on video</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>Exclusive Video Library</h2>
        <p>
          Access rare, leaked, and exclusive trading videos that reveal institutional trading secrets, 
          mentorship content, and advanced strategies from professional traders.
        </p>
        
        <div class="warning-box">
          <strong>⚠️ Educational Purposes Only:</strong> These videos are for educational use. Always verify information before trading.
        </div>
      </section>

      <!-- ICT Video Series -->
      <section class="section">
        <h2>ICT (Inner Circle Trader) Video Series</h2>
        <div class="videos-grid">
          <div class="video-card premium">
            <div class="thumbnail">🎬</div>
            <h3>ICT 2022 Mentorship - Full Series</h3>
            <p>Complete mentorship with core concepts and live trading</p>
            <div class="meta">
              <span>🔥 47 videos</span>
              <span>⏱️ 85+ hours</span>
            </div>
            <div class="badge">Most Requested</div>
          </div>
          
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>ICT 2016-2017 Mentorship</h3>
            <p>Original mentorship content - Foundation of ICT</p>
            <div class="meta">
              <span>📹 36 videos</span>
              <span>⏱️ 60+ hours</span>
            </div>
          </div>
          
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>ICT Core Content - Month 1-12</h3>
            <p>Complete core content from the original mentorship</p>
            <div class="meta">
              <span>📹 52 videos</span>
              <span>⏱️ 90+ hours</span>
            </div>
          </div>
          
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>ICT Silver Bullet Strategy</h3>
            <p>Detailed breakdown of the silver bullet setup</p>
            <div class="meta">
              <span>📹 12 videos</span>
              <span>⏱️ 15+ hours</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Smart Money Concepts Videos -->
      <section class="section">
        <h2>Smart Money Concepts (SMC) Video Series</h2>
        <div class="videos-grid">
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>Institutional Order Flow Masterclass</h3>
            <p>Complete guide to understanding institutional order flow</p>
            <div class="meta">
              <span>📹 24 videos</span>
              <span>⏱️ 35+ hours</span>
            </div>
          </div>
          
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>Liquidity Hunting Strategies</h3>
            <p>How to identify and profit from liquidity grabs</p>
            <div class="meta">
              <span>📹 18 videos</span>
              <span>⏱️ 25+ hours</span>
            </div>
          </div>
          
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>Order Block Trading Complete</h3>
            <p>Mastering order block identification and execution</p>
            <div class="meta">
              <span>📹 15 videos</span>
              <span>⏱️ 20+ hours</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Wyckoff Method Videos -->
      <section class="section">
