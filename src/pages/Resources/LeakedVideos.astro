            <div class="meta">
              <span>📹 10 videos</span>
              <span>⏱️ 12+ hours</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Market Structure Videos -->
      <section class="section">
        <h2>Market Structure & Analysis</h2>
        <div class="videos-grid">
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>Market Structure Pro</h3>
