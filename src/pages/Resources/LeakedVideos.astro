            <p>Identifying institutional accumulation zones</p>
            <div class="meta">
              <span>📹 8 videos</span>
              <span>⏱️ 12+ hours</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Price Action Video Series -->
      <section class="section">
        <h2>Advanced Price Action Videos</h2>
        <div class="videos-grid">
          <div class="video-card">
