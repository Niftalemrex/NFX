      </section>

      <!-- Access Instructions -->
      <section class="section">
        <h2>How to Access Videos</h2>
        <div class="instructions">
          <div class="instruction-step">
            <span class="step">1</span>
            <p>Click on any video title to request access</p>
          </div>
          <div class="instruction-step">
            <span class="step">2</span>
            <p>Verify your email address (required for security)</p>
          </div>
          <div class="instruction-step">
            <span class="step">3</span>
            <p>Access the complete video library</p>
          </div>
          <div class="instruction-step">
            <span class="step">4</span>
            <p>Stream or download videos (MP4 format)</p>
          </div>
        </div>
      </section>

      <!-- Disclaimer -->
      <section class="section">
        <div class="disclaimer">
          <p><strong>Disclaimer:</strong> These videos are provided for educational purposes. NFX does not claim ownership of any third-party content. All copyrighted materials belong to their respective owners. Always verify trading strategies before implementing them with real capital.</p>
        </div>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Explore More Resources</h2>
        <div class="next-links">
          <a href="/Resources/Psychology" class="next-link">
            <span>Trading Psychology →</span>
            <small>Master your mindset</small>
          </a>
          <a href="/Resources/LeakedBooks" class="next-link">
            <span>Leaked Books →</span>
