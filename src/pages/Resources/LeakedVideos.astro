      </section>

      <!-- Risk Management Videos -->
      <section class="section">
        <h2>Professional Risk Management</h2>
        <div class="videos-grid">
          <div class="video-card">
            <div class="thumbnail">🎬</div>
            <h3>Position Sizing Masterclass</h3>
            <p>Advanced position sizing strategies</p>
            <div class="meta">
              <span>📹 8 videos</span>
