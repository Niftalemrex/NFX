---
// Astro component frontmatter

import Layout from '../../layouts/BaseLayout.astro';
import './LeakedBooks.css';
---

<Layout title="Leaked Trading Books - NFX Learning">

  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>Leaked Books</h1>
        <p class="subtitle">Rare and exclusive trading resources - Knowledge that institutions don't want you to have</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>Exclusive Trading Library</h2>
        <p>
          Access rare, hard-to-find, and leaked trading resources that reveal institutional secrets, 
          advanced strategies, and insider knowledge. These materials are not available through conventional channels.
        </p>
        
        <div class="warning-box">
          <strong>⚠️ Educational Purposes Only:</strong> These materials are for educational use. Always verify information before trading.
        </div>
      </section>

      <!-- ICT Related Books -->
      <section class="section">
        <h2>ICT (Inner Circle Trader) Resources</h2>
        <div class="books-grid">
          <div class="book-card premium">
            <h3>📘 ICT Mentorship 2022-2024</h3>
            <p>Complete mentorship transcripts and core content</p>
            <div class="badge">🔥 Most Requested</div>
          </div>
          <div class="book-card">
            <h3>📗 ICT Forex Scout Sniper</h3>
            <p>Advanced order flow and market maker models</p>
          </div>
          <div class="book-card">
            <h3>📕 ICT 2016-2017 Mentorship</h3>
            <p>Original mentorship content - Foundation of ICT concepts</p>
          </div>
          <div class="book-card">
            <h3>📙 ICT Silver Bullet Strategy</h3>
            <p>High-probability setup documentation</p>
          </div>
        </div>
      </section>

      <!-- Smart Money Concepts Books -->
      <section class="section">
        <h2>Smart Money Concepts (SMC)</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Institutional Order Flow</h3>
            <p>How banks and institutions move the markets</p>
          </div>
          <div class="book-card">
            <h3>📗 Liquidity Sweep Secrets</h3>
            <p>Understanding and profiting from stop hunts</p>
          </div>
          <div class="book-card">
            <h3>📕 Order Block Encyclopedia</h3>
            <p>Complete guide to identifying and trading order blocks</p>
          </div>
        </div>
      </section>

      <!-- Wyckoff Method -->
      <section class="section">
        <h2>Wyckoff Method Resources</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Wyckoff 2.0</h3>
            <p>Modern application of the Wyckoff Method</p>
          </div>
          <div class="book-card">
            <h3>📗 Accumulation & Distribution</h3>
            <p>Identifying institutional accumulation zones</p>
          </div>
          <div class="book-card">
            <h3>📕 Wyckoff Schematics</h3>
            <p>Complete schematics for all market phases</p>
          </div>
        </div>
      </section>

      <!-- Elliott Wave Resources -->
      <section class="section">
        <h2>Elliott Wave Theory</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Elliott Wave Principle</h3>
            <p>Key to market behavior - Advanced concepts</p>
          </div>
          <div class="book-card">
            <h3>📗 Wave Patterns Guide</h3>
            <p>Visual guide to all Elliott Wave patterns</p>
          </div>
        </div>
      </section>

      <!-- Price Action Books -->
      <section class="section">
        <h2>Advanced Price Action</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Naked Forex</h3>
            <p>High-probability techniques for trading without indicators</p>
          </div>
          <div class="book-card">
            <h3>📗 Price Action Trading Secrets</h3>
            <p>Professional price action strategies</p>
          </div>
          <div class="book-card">
            <h3>📕 Support & Resistance Pro</h3>
            <p>Advanced support/resistance techniques</p>
          </div>
        </div>
      </section>

      <!-- Algorithmic Trading -->
      <section class="section">
        <h2>Algorithmic & High-Frequency Trading</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 HFT Secrets</h3>
            <p>Understanding high-frequency trading algorithms</p>
          </div>
          <div class="book-card">
            <h3>📗 Dark Pools Explained</h3>
            <p>How institutional trades are executed off-exchange</p>
          </div>
        </div>
      </section>

      <!-- Forex Market Structure -->
      <section class="section">
        <h2>Forex Market Structure</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Interbank Market Secrets</h3>
            <p>How the real forex market operates</p>
          </div>
          <div class="book-card">
            <h3>📗 Liquidity Provider Strategies</h3>
            <p>How LPs and banks profit from retail flow</p>
          </div>
          <div class="book-card">
            <h3>📕 Broker Execution Models</h3>
            <p>Understanding how your broker fills orders</p>
          </div>
        </div>
      </section>

      <!-- Risk Management Books -->
      <section class="section">
        <h2>Advanced Risk Management</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Professional Position Sizing</h3>
            <p>Advanced position sizing algorithms</p>
          </div>
          <div class="book-card">
            <h3>📗 Kelly Criterion Pro</h3>
            <p>Optimal position sizing for trading</p>
          </div>
        </div>
      </section>

      <!-- Trading Psychology Books -->
      <section class="section">
        <h2>Advanced Trading Psychology</h2>
        <div class="books-grid">
          <div class="book-card">
            <h3>📘 Trading Psych 2.0</h3>
            <p>Next-level psychological techniques</p>
          </div>
          <div class="book-card">
            <h3>📗 Peak Performance Trading</h3>
            <p>Mental strategies of top traders</p>
          </div>
        </div>
      </section>

      <!-- Download Instructions -->
      <section class="section">
        <h2>Access Instructions</h2>
        <div class="instructions">
          <div class="instruction-step">
            <span class="step">1</span>
            <p>Click on any book title to request access</p>
          </div>
          <div class="instruction-step">
            <span class="step">2</span>
            <p>Verify your email address (required for security)</p>
          </div>
          <div class="instruction-step">
            <span class="step">3</span>
            <p>Access the resource library with all materials</p>
          </div>
          <div class="instruction-step">
            <span class="step">4</span>
            <p>Download PDF, EPUB, or video files</p>
          </div>
        </div>
      </section>

      <!-- Disclaimer -->
      <section class="section">
        <div class="disclaimer">
          <p><strong>Disclaimer:</strong> These resources are provided for educational purposes. NFX does not claim ownership of any third-party materials. All copyrighted materials belong to their respective owners. Always verify trading strategies before implementing them with real capital.</p>
        </div>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Explore More Resources</h2>
        <div class="next-links">
          <a href="/Resources/Psychology" class="next-link">
            <span>Trading Psychology →</span>
            <small>Master your mindset</small>
          </a>
          <a href="/Resources/LeakedVideos" class="next-link">
            <span>Leaked Videos →</span>
            <small>Exclusive trading content</small>
          </a>
        </div>
      </section>
    </div>
  </main>
  

</Layout>