---
// Astro component frontmatter

import Layout from '../../../layouts/BaseLayout.astro';
import './MetaTrader.css';
---

<Layout title="MetaTrader 4/5 Guide - NFX Learning">
 
  
  <main class="page-container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-content">
        <h1>MetaTrader 4/5 Guide</h1>
        <p class="subtitle">Master the industry standard trading platform</p>
      </div>
    </section>

    <!-- Main Content -->
    <div class="content-wrapper">
      <!-- Introduction -->
      <section class="section">
        <h2>What is MetaTrader?</h2>
        <p>
          MetaTrader is the world's most popular trading platform, used by millions of traders worldwide. 
          Both MT4 and MT5 offer powerful charting tools, automated trading capabilities, and a user-friendly interface.
        </p>
        
        <div class="comparison-grid">
          <div class="comparison-card">
            <h3>MetaTrader 4 (MT4)</h3>
            <ul>
              <li>✓ Best for Forex trading</li>
              <li>✓ Simpler interface</li>
              <li>✓ Larger ECN community</li>
              <li>✓ 4 order types</li>
            </ul>
          </div>
          <div class="comparison-card">
            <h3>MetaTrader 5 (MT5)</h3>
            <ul>
              <li>✓ Multi-asset support</li>
              <li>✓ More timeframes (21 vs 9)</li>
              <li>✓ Built-in economic calendar</li>
              <li>✓ 6 order types</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Getting Started -->
      <section class="section">
        <h2>Getting Started</h2>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <h3>Download & Install</h3>
            <p>Download MT4/MT5 from your broker's website. Installation takes just a few minutes.</p>
          </div>
          <div class="step-card">
            <div class="step-number">2</div>
            <h3>Login to Your Account</h3>
            <p>Use your demo or real account credentials provided by your broker.</p>
          </div>
          <div class="step-card">
            <div class="step-number">3</div>
            <h3>Explore the Interface</h3>
            <p>Familiarize yourself with Market Watch, Navigator, Chart Window, and Terminal.</p>
          </div>
        </div>
      </section>

      <!-- Key Features -->
      <section class="section">
        <h2>Key Features</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Advanced Charting</h3>
            <p>9 timeframes, 30+ technical indicators, and 24 drawing tools for detailed analysis.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🤖</div>
            <h3>Expert Advisors (EAs)</h3>
            <p>Automate your trading strategies using MQL4/MQL5 programming language.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Mobile Trading</h3>
            <p>Trade from anywhere with full-featured iOS and Android apps.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🔧</div>
            <h3>Custom Indicators</h3>
            <p>Access thousands of free and paid indicators from the MQL5 community.</p>
          </div>
        </div>
      </section>

      <!-- Placing a Trade -->
      <section class="section">
        <h2>How to Place a Trade</h2>
        <div class="trade-tutorial">
          <div class="tutorial-step">
            <span class="step-label">Step 1</span>
            <p>Right-click on any currency pair in Market Watch → Select "New Order"</p>
          </div>
          <div class="tutorial-step">
            <span class="step-label">Step 2</span>
            <p>Choose order type: Market Execution or Pending Order</p>
          </div>
          <div class="tutorial-step">
            <span class="step-label">Step 3</span>
            <p>Set volume (lot size), Stop Loss, and Take Profit levels</p>
          </div>
          <div class="tutorial-step">
            <span class="step-label">Step 4</span>
            <p>Click "Buy" or "Sell" to execute your trade</p>
          </div>
        </div>
      </section>

      <!-- Essential Shortcuts -->
      <section class="section">
        <h2>Essential Keyboard Shortcuts</h2>
        <div class="shortcuts-grid">
          <div class="shortcut">
            <kbd>Ctrl + N</kbd>
            <span>Open Navigator</span>
          </div>
          <div class="shortcut">
            <kbd>Ctrl + M</kbd>
            <span>Open Market Watch</span>
          </div>
          <div class="shortcut">
            <kbd>Ctrl + T</kbd>
            <span>Open Terminal</span>
          </div>
          <div class="shortcut">
            <kbd>F1</kbd>
            <span>Help</span>
          </div>
          <div class="shortcut">
            <kbd>F4</kbd>
            <span>MetaEditor (MQL4)</span>
          </div>
          <div class="shortcut">
            <kbd>Alt + 1-3</kbd>
            <span>Chart types (Bar, Candle, Line)</span>
          </div>
        </div>
      </section>

      <!-- Next Steps -->
      <section class="section next-steps">
        <h2>Ready to Master MetaTrader?</h2>
        <div class="next-links">
          <a href="/Learn/PlatformTools/TradingViewGuide" class="next-link">
            <span>TradingView Guide →</span>
            <small>Chart like a pro</small>
          </a>
          <a href="/Learn/PlatformTools/AutomatedTrading" class="next-link">
            <span>Automated Trading →</span>
            <small>EAs and bots explained</small>
          </a>
        </div>
      </section>
    </div>
  </main>
  

</Layout>